      "parameters": {
        "jsCode": "const article =\n  $('Message a model').first().json.output[0].content[0].text;\n\nconst image1 = $('Upload file').first().json;\nconst image2 = $('Upload file1').first().json;\nconst image3 = $('Upload file2').first().json;\n\nif (!article) {\n  throw new Error('找不到文章內容');\n}\n\nif (!image1.id || !image2.id || !image3.id) {\n  throw new Error('找不到三張圖片的 Google Drive file ID');\n}\n\nconst url1 = `https://drive.google.com/uc?export=view&id=${image1.id}`;\nconst url2 = `https://drive.google.com/uc?export=view&id=${image2.id}`;\nconst url3 = `https://drive.google.com/uc?export=view&id=${image3.id}`;\n\nconst finalArticle = article\n  .replace(/\\[IMAGE_1\\]/g, `![圖片1](${url1})`)\n  .replace(/\\[IMAGE_2\\]/g, `![圖片2](${url2})`)\n  .replace(/\\[IMAGE_3\\]/g, `![圖片3](${url3})`);\n\nreturn [\n  {\n    json: {\n      article: finalArticle,\n      image_url_1: url1,\n      image_url_2: url2,\n      image_url_3: url3,\n      image_file_id_1: image1.id,\n      image_file_id_2: image2.id,\n      image_file_id_3: image3.id\n    }\n  }\n];"
      },
