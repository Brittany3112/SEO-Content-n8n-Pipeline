      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst text =\n  input.output?.[0]?.content?.find(item => item.type === 'output_text')?.text ??\n  input.output?.[0]?.content?.[0]?.text ??\n  input.output_text ??\n  input.text ??\n  '';\n\nif (!text) {\n  throw new Error('找不到模型輸出文字');\n}\n\nconst start = text.indexOf('[');\nconst end = text.lastIndexOf(']');\n\nif (start === -1 || end === -1 || end <= start) {\n  throw new Error('找不到 JSON 陣列');\n}\n\nconst jsonStr = text.slice(start, end + 1);\n\nlet imagePrompts;\ntry {\n  imagePrompts = JSON.parse(jsonStr);\n} catch (error) {\n  throw new Error(`JSON 解析失敗：${error.message}`);\n}\n\nif (!Array.isArray(imagePrompts) || imagePrompts.length < 3) {\n  throw new Error('圖片 prompt 必須至少 3 個');\n}\n\nreturn [{\n  json: {\n    image_prompt_1: imagePrompts[0].prompt,\n    image_prompt_2: imagePrompts[1].prompt,\n    image_prompt_3: imagePrompts[2].prompt,\n    image_size_1: imagePrompts[0].size || '1024x1024',\n    image_size_2: imagePrompts[1].size || '1024x1024',\n    image_size_3: imagePrompts[2].size || '1024x1024',\n  }\n}];"
      },
